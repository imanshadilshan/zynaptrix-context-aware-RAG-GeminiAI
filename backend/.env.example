# Database Configuration (Neon PostgreSQL with pgvector)
# Fallback to local SQLite is automatically active if this URL is left blank or sqlite:///./local_rag.db is used
DATABASE_URL=postgresql://neondb_owner:YOUR_SECRET_PASSWORD@YOUR_NEON_HOST.us-east-1.aws.neon.tech/neondb?sslmode=require

# Google Gemini AI API Configuration
# Pro and Flash models are automatically routed via this central credential
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Service URL Routing
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Logging Level
LOG_LEVEL=INFO

# Cloudinary Cloud CDN Storage for Multimodal Layout Croppings
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
